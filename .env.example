# Copy this file to .env for a local Docker Compose run. Never use these values in production.
POSTGRES_DB=stayeasy
POSTGRES_USER=stayeasy
POSTGRES_PASSWORD=stayeasy-local-dev-change-me
APP_ENV=development
# Replace with a random value of at least 32 characters before starting the API.
JWT_SECRET=local-development-secret-change-this-to-a-random-value-over-32-chars
JWT_ISSUER=stayeasy-api
ACCESS_TOKEN_MINUTES=120
# Optional; enables the local-only POST /auth/dev-token endpoint when set.
DEV_TOKEN_PASSWORD=stayeasy-local-only-change-me
API_PORT=8000
# Bind to loopback for the safest local setup. Android emulator reaches it at 10.0.2.2:8000.
API_BIND_HOST=127.0.0.1
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Razorpay online payments (use test-mode values in local/staging only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional authorised external listing partner JSON feed. Leave blank unless you have permission.
PROPERTY_FEED_URL=
PROPERTY_FEED_SOURCE=partner-feed
PROPERTY_FEED_TOKEN=
PROPERTY_FEED_POLL_SECONDS=300

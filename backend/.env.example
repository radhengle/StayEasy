APP_ENV=development
DATABASE_URL=postgresql+psycopg://stayeasy:change-this-password@db:5432/stayeasy
# Replace this with a random secret of at least 32 bytes before exposing the service.
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_ISSUER=stayeasy-api
ACCESS_TOKEN_MINUTES=120
# Optional local-only developer token endpoint; leave empty in shared/prod deployments.
DEV_TOKEN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Razorpay online payments (use test-mode values in local/staging only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
